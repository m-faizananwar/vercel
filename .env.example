# App
NEXT_PUBLIC_APP_NAME=ProjectFlow
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication
JWT_SECRET=your-jwt-secret-change-me

# OAuth (GitHub via Supabase - optional)
NEXT_PUBLIC_AUTH_GITHUB=false
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI / OpenRouter (choose one provider or both)
OPENAI_API_KEY=
OPENAI_ASSISTANT_ID=

OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=${NEXT_PUBLIC_APP_NAME}

# Platform (Vercel)
# VERCEL_URL is injected by Vercel at runtime; leave empty locally
VERCEL_URL=

# UI Defaults
# DEFAULT_CHAT_TITLE=New chat
